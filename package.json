{
  "name": "tiddeligames",
  "version": "0.0.1",
  "description": "Simple children's games PWA",
  "scripts": {
    "build-css": "tailwindcss -i ./css/styles.css -o ./css/tailwind.output.css --minify",
    "watch-css": "tailwindcss -i ./css/styles.css -o ./css/tailwind.output.css --watch",
    "serve": "live-server --port=5502 --open=/index.html --watch=css,js,games,index.html,sw.js,manifest.json",
    "serve:promptgenerator": "live-server promptgenerator --port=5508 --open=/index.html --watch=promptgenerator --no-browser",
    "dev": "concurrently -k -n css,serve -c blue,green \"npm run watch-css\" \"npm run serve\"",
    "tts-api": "node --use-system-ca scripts/local-tts-api.js",
    "dev:full": "concurrently --kill-others-on-fail -n css,serve,tts -c blue,green,magenta \"npm run watch-css\" \"npm run serve\" \"npm run tts-api\"",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "concurrently": "^10.0.6",
    "live-server": "^1.2.2",
    "tailwindcss": "^3.4.0"
  },
  "dependencies": {
    "fluent-ffmpeg": "^2.1.3"
  }
}
